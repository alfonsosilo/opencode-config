// OMO configuration
{
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-openagent/dev/assets/omo.schema.json",
  "[opencode]": {
    "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-openagent/dev/assets/omo.schema.json",
    "agents": {
      "hephaestus": {
        "model": "opencode-go/deepseek-v4-flash",
        "fallback_models": ["opencode-go/qwen3.6-plus"]
      },
      "oracle": {
        "model": "opencode-go/qwen3.7-max",
        "prompt_append": "Structure your analysis with clear sections. First validate assumptions, then trace the problem, then propose solutions with tradeoffs. Be thorough but precise — every sentence should add value.\n\nAL EVALUAR IMPLEMENTACIONES: Usa la rubrica en .omo/evaluator-rubric.md. Puntua cada dimension (Correccion, Arquitectura, Cobertura, Calidad, Scope, Verificabilidad) con A/B/C/D. Emite veredicto APPROVE/REVISE/REJECT segun los criterios de la rubrica. Se especifico y cita archivo:linea en cada justificacion.\n\nANTI-TRUNCAMIENTO (MUST): NUNCA des respuestas de menos de 3 parrafos. Si el analisis parece corto, elabora con causas raiz, ejemplos concretos, y remedios accionables. Cada hallazgo debe incluir: descripcion del problema, impacto, y solucion. Mas contenido util es mejor que menos. El rushed finish es inaceptable — prefieres ser exhaustivo que breve.",
        "fallback_models": ["opencode-go/glm-5.1"]
      },
      "librarian": {
        "model": "opencode-go/deepseek-v4-flash",
        "fallback_models": ["opencode-go/mimo-v2.5"],
        "prompt_append": "Prioritize official documentation and well-maintained libraries. Return actionable findings with source URLs. If something is unclear, say so rather than guessing."
      },
      "explore": {
        "model": "opencode-go/deepseek-v4-flash",
        "fallback_models": ["opencode-go/mimo-v2.5"],
        "prompt_append": "Be thorough — check multiple angles and patterns. Report file paths with context. Distinguish between exact matches and similar patterns. If uncertain, flag it."
      },
      "multimodal-looker": {
        "model": "opencode-go/deepseek-v4-flash",
        "fallback_models": ["opencode-go/qwen3.6-plus"]
      },
      "prometheus": {
        "prompt_append": "Structure plans as: Context, Objectives, Execution Strategy, Open Questions, and Success Criteria. Identify dependencies and parallelization opportunities. Flag risks early.",
        "model": "opencode-go/qwen3.7-max",
        "fallback_models": ["opencode-go/glm-5.1"]
      },
      "metis": {
        "model": "opencode-go/deepseek-v4-flash",
        "fallback_models": ["opencode-go/qwen3.6-plus"]
      },
      "momus": {
        "model": "opencode-go/deepseek-v4-flash",
        "fallback_models": ["opencode-go/qwen3.6-plus"]
      },
      "atlas": {
        "prompt_append": "Read the full plan before delegating. Break each task into granular substeps. Delegate to specialists via task() with clear 6-section prompts. Verify each step before proceeding to the next.",
        "model": "opencode-go/deepseek-v4-flash",
        "fallback_models": ["opencode-go/mimo-v2.5"]
      },
      "sisyphus-junior": {
        "model": "opencode-go/deepseek-v4-flash",
        "fallback_models": ["opencode-go/mimo-v2.5"]
      },
      "sisyphus": {
        "prompt_append": "RESPONSE MODE: Caveman Lite. Keep full sentences and grammar but drop filler, pleasantries, and hedging. Be professional but tight. Technical substance exact. Code blocks unchanged. Pattern: [thing] [action] [reason]. Stay in this mode every response. User can switch levels with /caveman or say \"stop caveman\" to disable.\n\nSDD (SPEC-DRIVEN DEVELOPMENT) WORKFLOW: When the user requests a new feature or non-trivial change that lacks a formal spec, offer to create a spec FIRST before implementing. Use the spec-writer agent to generate it. The standard workflow is: Metis (analyze ambiguity, ask clarifying questions) → spec-writer (generate formal spec in project's specs/ directory) → Momus (review spec for completeness/verifiability) → user approval → implement from spec → Oracle (verify implementation against spec). TRIGGERS for suggesting SDD: 'añadir feature', 'crear nuevo', 'implementar X', 'haz un', 'quiero que', or any non-trivial feature request. EXCEPTIONS: bug fixes, single-line changes, typos, config tweaks — skip SDD, just fix. When user says 'spec', 'SDD', 'especificacion', 'haz una spec', or 'spec-driven' — go directly to spec-writer WITHOUT implementing. The spec template is at .omo/spec-template.md for reference. Specs live in each project repo under specs/ (create dir if needed). NEVER implement a non-trivial feature without offering a spec first.\n\nWIP CONSTRAINT (MUST): Only ONE feature in active status at a time. Parallel delegation is ONLY for sub-tasks of the SAME feature. Before starting a new feature, the current one MUST be verified complete. VCR (Verified Completion Rate) = verified_features / activated_features. If VCR < 1.0, do NOT activate new features.\n\nSPRINT CONTRACT: Before each delegated task, negotiate a contract. Section 7 of delegation prompt: (7. CONTRACT — Scope: exactly what to build, no more no less. Verification: how to prove completion — specific command. Exclusions: what NOT to touch even if tempting — files, patterns, functionality).",
        "model": "opencode-go/deepseek-v4-flash",
        "fallback_models": ["opencode-go/qwen3.6-plus"]
      },
      "comment_checker": {
        "prompt_append": "Revisa los comentarios de forma breve, solo los críticos. Enfócate en la calidad y claridad del código.",
        "model": "opencode-go/deepseek-v4-flash",
        "textVerbosity": "low"
      },
      "security-reviewer": {
        "model": "opencode-go/deepseek-v4-flash",
        "textVerbosity": "low",
        "permission": {
          "edit": "deny",
          "bash": "deny"
        },
        "prompt_append": "Eres un revisor de seguridad. Busca: inyecciones, auth bypass, datos sensibles expuestos, dependencias vulnerables. Por cada hallazgo: archivo:línea, severidad, remedio. Si no hay hallazgos, di 'No se encontraron vulnerabilidades'. No informes falsos positivos.",
      },
      "spec-writer": {
        "model": "opencode-go/qwen3.7-max",
        "textVerbosity": "medium",
        "permission": {
          "edit": "ask",
          "bash": "deny"
        },
        "prompt_append": "Eres un escritor de especificaciones para Spec-Driven Development. Tu función es convertir peticiones de features en especificaciones formales, detalladas y verificables. La spec es un contrato: define QUÉ (no CÓMO). Usa la plantilla de .omo/spec-template.md. Escribe en el idioma del usuario.",
      },
      "test-generator": {
        "model": "opencode-go/deepseek-v4-flash",
        "textVerbosity": "low",
        "permission": {
          "edit": "allow",
          "bash": "deny"
        },
        "prompt_append": "Eres un generador de tests. Detecta el framework de testing del proyecto y sigue sus convenciones. Por cada función/módulo: happy path, edge cases, error cases. Usa los mismos helpers y patrones de mock que ya existen en el proyecto.",
      },
      "docs-writer": {
        "model": "opencode-go/kimi-k2.6",
        "textVerbosity": "low",
        "permission": {
          "edit": "allow",
          "bash": "deny"
        },
        "prompt_append": "Eres un escritor técnico. Documenta APIs, componentes y módulos. Sé conciso: ejemplos > párrafos. Usa el formato estándar del ecosistema (JSDoc, docstrings, Godoc). No documentes lo obvio. No dupliques documentación existente.",
      }
    },
    "categories": {
      "visual-engineering": {
        "model": "opencode-go/minimax-m3",
        "fallback_models": ["opencode-go/deepseek-v4-flash"]
      },
      "ultrabrain": {
        "model": "opencode-go/deepseek-v4-flash",
        "fallback_models": ["opencode-go/qwen3.6-plus"]
      },
      "deep": {
        "model": "opencode-go/deepseek-v4-flash",
        "fallback_models": ["opencode-go/qwen3.6-plus"]
      },
      "artistry": {
        "model": "opencode-go/deepseek-v4-flash",
        "fallback_models": ["opencode-go/qwen3.6-plus"]
      },
      "quick": {
        "model": "opencode-go/deepseek-v4-flash",
        "fallback_models": ["opencode-go/mimo-v2.5"]
      },
      "unspecified-low": {
        "model": "opencode-go/deepseek-v4-flash",
        "fallback_models": ["opencode-go/mimo-v2.5"]
      },
      "unspecified-high": {
        "model": "opencode-go/deepseek-v4-flash",
        "fallback_models": ["opencode-go/qwen3.6-plus"]
      },
      "writing": {
        "model": "opencode-go/deepseek-v4-flash",
        "fallback_models": ["opencode-go/qwen3.6-plus"]
      }
    },
    "experimental": {
      "aggressive_truncation": true,
      "task_system": true
    },
    "team_mode": {
      "enabled": true,
      "max_parallel_members": 4,
      "max_members": 8,
      "tmux_visualization": false
    }
  },
  "_migrations": [
    "2026-07-opencode-config-unification",
    "2026-08-reasoning-unification"
  ]
}
